# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 로컬에서 Google 없이 실행하려면 memory (인증이 꺼짐. Vercel production에서는 항상 무시됨)
# DATA_BACKEND=memory
# production 빌드(next start)에서 memory를 쓰려면 아래 두 값도 필요 (E2E 전용)
# ALLOW_MEMORY_BACKEND_IN_PRODUCTION=1
# AUTH_TRUST_HOST=1
